# Copy to .env and fill in. .env is gitignored; this template is versioned.
# The instance file (instances/*.json) names which of these variables it
# uses, so the names below are the defaults, not requirements.

# Microsoft Entra app registration (public client, Mail.Read + offline_access)
MS_CLIENT_ID=

# Google Cloud -- Credentials > OAuth client (Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Used only by create-test-event.mjs (the one-time consent + smoke test).
GOOGLE_CALENDAR_ID=

# Optional overrides -- defaults shown.
# ERRAND_MCP_OPERATOR_NAME=          # audit "operator"; defaults to the OS user
# ERRAND_MCP_CONFIRM_TTL_MS=300000   # how long a live confirmation stays valid
# ERRAND_MCP_SLIP_RETENTION_DAYS=14  # request images: days after the trip date
# ERRAND_MCP_HANDLE_RETENTION_HOURS=24
# ERRAND_MCP_AUDIT_RETENTION_DAYS=2190  # rotated audit files (no PHI)
# ERRAND_MCP_AUDIT_MAX_BYTES=10485760   # audit log rotation size

{
  "name": "errand-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A governed MCP server that turns an emailed transportation request into a scheduled trip on a driver's calendar.",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "google-auth-library": "^11.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
